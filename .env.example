# Server Configuration
NODE_ENV=development
PORT=5000

# Database Connection (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/fintech_dashboard
# For Production (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/fintech_dashboard?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Legacy Email (Gmail App Password - if using Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Cloudinary Credentials (Profile and Video Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Paystack Payment Gateway (Test or Live Keys)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_CALLBACK_URL=http://localhost:5000/callback.html
# For Production:
# PAYSTACK_CALLBACK_URL=https://your-domain.up.railway.app/callback.html

# Resend Email Service (Transactional Emails & OTP)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev